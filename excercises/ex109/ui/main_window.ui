  <property name="styleSheet">
   <string>
QWidget { font-family: "Segoe UI"; font-size: 14px; color: #24333e; }
QMainWindow, QWidget#root { background: #ffffff; }
QLabel[role="title"] { font-size: 23px; font-weight: 600; }
QLabel[role="sectionTitle"] { font-size: 16px; font-weight: 600; }
QLabel[role="muted"], QLabel#status { color: #52616c; font-size: 13px; }
QLabel[role="metricValue"] { font-size: 18px; font-weight: 600; }
QLineEdit, QSpinBox {
 background: white; border: 1px solid #9daab4; border-radius: 4px;
 padding: 6px 9px; min-height: 22px; selection-background-color: #176c60;
}
QLineEdit:focus, QSpinBox:focus { border: 1px solid #176c60; background: #f4faf8; }
QPushButton {
 background: #176c60; color: white; border: 1px solid #176c60;
 border-radius: 4px; padding: 7px 13px; min-height: 20px; font-weight: 600;
}
QPushButton:hover { background: #105449; }
QPushButton:pressed { background: #0b4038; }
QPushButton:focus { border: 2px solid #163c54; padding: 6px 12px; }
QPushButton[role="secondary"] { background: white; color: #334955; border: 1px solid #b8c3ca; }
QPushButton[role="secondary"]:hover { background: #edf2f4; }
QPushButton:disabled { background: #edf0f2; color: #697781; border-color: #d0d8dd; }
QLabel#error { color: #a52d26; background: #fff3f1; padding: 8px; }
QTableWidget { background: white; alternate-background-color: #f6f8f9;
 border: 1px solid #ccd5db; gridline-color: #e6ebee;
 selection-background-color: #dceee9; selection-color: #173f35; }
QHeaderView::section { background: #edf1f3; padding: 8px 6px;
 color: #334955; border: none; border-bottom: 1px solid #ccd5db; font-weight: 600; }
QTableWidget::item { padding: 4px; }
QScrollArea { border: none; background: transparent; }
QTabWidget::pane { border: none; }
QTabBar::tab { background: white; color: #52616c; padding: 9px 16px;
 border-bottom: 2px solid #dbe2e6; }
QTabBar::tab:selected { color: #115c50; border-bottom: 2px solid #176c60; font-weight: 600; }
QTabBar::tab:hover { background: #f1f6f4; }
QToolTip { background: white; color: #24333e; border: 1px solid #9daab4; padding: 6px; }
</string>
